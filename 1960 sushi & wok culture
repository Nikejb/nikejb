var cart = {};

function fmt(n){ return "$" + n.toLocaleString("es-AR"); }

function imgHTML(p){
  if(photos[p.id]){
    return "<div class=\"product-img\"><img src=\"" + photos[p.id] + "\" alt=\"" + p.name + "\"></div>";
  }
  return "<div class=\"product-img\"><div class=\"product-img-placeholder\"><span class=\"photo-icon\">📷</span><span class=\"photo-label\">" + p.name + "</span></div></div>";
}

function renderGrid(cat){
  var grid = document.getElementById("grid-" + cat);
  if(!grid) return;
  var html = "";
  for(var i=0; i<menu[cat].length; i++){
    var p = menu[cat][i];
    var tagsHTML = "";
    for(var j=0; j<p.tags.length; j++){
      var cls = (p.tags[j]==="vegano"||p.tags[j]==="vegetariano") ? "tag-v" : "tag-p";
      tagsHTML += "<span class=\"tag " + cls + "\">" + p.tags[j] + "</span>";
    }
    html += "<div class=\"product-card\">" +
      imgHTML(p) +
      "<div class=\"product-info\">" +
        "<p class=\"product-name\">" + p.name + "</p>" +
        "<p class=\"product-desc\">" + p.desc + "</p>" +
        (tagsHTML ? "<div class=\"product-tags\">" + tagsHTML + "</div>" : "") +
        "<div class=\"product-footer\">" +
          "<div><p class=\"product-price\">" + fmt(p.price) + "</p><p class=\"product-pzas\">" + p.pzas + "</p></div>" +
          "<button class=\"add-btn\" id=\"btn-" + p.id + "\" onclick=\"addToCart('" + p.id + "','" + p.name + "'," + p.price + ")\">+</button>" +
        "</div>" +
      "</div>" +
    "</div>";
  }
  grid.innerHTML = html;
}

function addToCart(id, name, price){
  if(!cart[id]) cart[id] = {name:name, price:price, qty:0};
  cart[id].qty++;
  updateCartUI();
  var btn = document.getElementById("btn-" + id);
  if(btn){ btn.textContent = "✓"; btn.classList.add("added"); setTimeout(function(){ btn.textContent = "+"; btn.classList.remove("added"); }, 800); }
}

function removeFromCart(id){
  if(!cart[id]) return;
  cart[id].qty--;
  if(cart[id].qty <= 0) delete cart[id];
  updateCartUI();
}

function updateCartUI(){
  var items = Object.entries(cart);
  var count = items.reduce(function(s,v){ return s + v[1].qty; }, 0);
  var total = items.reduce(function(s,v){ return s + v[1].price * v[1].qty; }, 0);
  document.getElementById("cartCount").textContent = count;
  var container = document.getElementById("cartItems");
  var totalDiv  = document.getElementById("cartTotal");
  var waBtn     = document.getElementById("waBtn");
  if(items.length === 0){
    container.innerHTML = "<p class=\"cart-empty\">Todav\u00eda no agregaste nada.</p>";
    totalDiv.style.display = "none";
    waBtn.disabled = true;
  } else {
    var h = "";
    for(var i=0; i<items.length; i++){
      var id = items[i][0]; var v = items[i][1];
      h += "<div class=\"cart-item\"><p class=\"cart-item-name\">" + v.name + "</p>" +
        "<div class=\"cart-item-qty\">" +
          "<button class=\"qty-btn\" onclick=\"removeFromCart('" + id + "')\">\u2212</button>" +
          "<span class=\"qty-num\">" + v.qty + "</span>" +
          "<button class=\"qty-btn\" onclick=\"addToCart('" + id + "','" + v.name + "'," + v.price + ")\">+</button>" +
        "</div>" +
        "<p class=\"cart-item-price\">" + fmt(v.price * v.qty) + "</p></div>";
    }
    container.innerHTML = h;
    totalDiv.style.display = "flex";
    document.getElementById("cartTotalPrice").textContent = fmt(total);
    waBtn.disabled = false;
  }
}

function toggleCart(){ document.getElementById("cartPanel").classList.toggle("open"); }

function sendToWhatsApp(){
  var items = Object.entries(cart);
  if(!items.length) return;
  var total = items.reduce(function(s,v){ return s + v[1].price * v[1].qty; }, 0);
  var msg = "Hola! Quiero hacer un pedido de Aki Sushi:\n\n";
  for(var i=0; i<items.length; i++){
    var v = items[i][1];
    msg += "\u2022 " + v.qty + "x " + v.name + " \u2014 " + fmt(v.price * v.qty) + "\n";
  }
  msg += "\n*Total: " + fmt(total) + "*\n\nPor favor confirmen disponibilidad y zona de entrega. \u00a1Gracias!";
  window.open("https://wa.me/5493412277883?text=" + encodeURIComponent(msg), "_blank");
}

var sections = ["clasico","premium","veggies","niguiris","combos"];
var catBtns = document.querySelectorAll(".cat-btn");
var NAV_H = 110;

catBtns.forEach(function(btn, i){
  btn.addEventListener("click", function(){
    var el = document.getElementById(sections[i]);
    if(!el) return;
    var top = el.getBoundingClientRect().top + window.scrollY - NAV_H;
    window.scrollTo({top:top, behavior:"smooth"});
    catBtns.forEach(function(b){ b.classList.remove("active"); });
    btn.classList.add("active");
  });
});

function updateActive(){
  var current = 0;
  for(var i=0; i<sections.length; i++){
    var el = document.getElementById(sections[i]);
    if(el && el.getBoundingClientRect().top <= NAV_H + 20) current = i;
  }
  catBtns.forEach(function(b){ b.classList.remove("active"); });
  catBtns[current].classList.add("active");
}

window.addEventListener("scroll", updateActive, {passive:true});

["clasico","premium","veggies","niguiris","combos"].forEach(renderGrid);
</script>
</body>
</html>
