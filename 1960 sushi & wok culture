<style>
:root{--carbon:#1C1612;--carbon2:#251D17;--carbon3:#2E2018;--beige:#F5ECD8;--beige2:#EDE0C8;--orange:#C4622D;--muted:#8A7560;--green:#639922;}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--carbon);color:var(--beige);font-family:'Jost',sans-serif;font-weight:300;}
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(28,22,18,.96);backdrop-filter:blur(10px);border-bottom:1px solid rgba(245,236,216,.06);padding:0 5vw;height:58px;display:flex;align-items:center;justify-content:space-between;}
.nav-logo{font-family:'Playfair Display',serif;font-size:20px;color:var(--beige);text-decoration:none;}
.nav-logo span{color:var(--orange);}
.nav-cart{background:var(--orange);color:var(--beige);border:none;border-radius:20px;padding:8px 16px;font-family:'Jost',sans-serif;font-size:12px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;}
.cart-count{background:var(--beige);color:var(--orange);border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;}
.hero{padding:90px 5vw 40px;text-align:center;border-bottom:1px solid rgba(245,236,216,.06);}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(32px,7vw,52px);font-weight:400;margin-bottom:8px;}
.hero-title em{font-style:italic;color:var(--beige2);}
.hero-sub{font-size:13px;color:var(--muted);margin-bottom:6px;}
.hero-kanji{font-family:serif;font-size:22px;color:var(--orange);opacity:.6;}
.cat-nav{display:flex;overflow-x:auto;padding:0 5vw;border-bottom:1px solid rgba(245,236,216,.06);position:sticky;top:58px;z-index:90;background:rgba(28,22,18,.96);backdrop-filter:blur(10px);}
.cat-btn{font-size:11px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);background:none;border:none;border-bottom:2px solid transparent;padding:13px 16px;cursor:pointer;white-space:nowrap;transition:color .2s,border-color .2s;margin-bottom:-1px;font-family:'Jost',sans-serif;}
.cat-btn.active{color:var(--beige);border-bottom-color:var(--orange);}
.section{padding:32px 5vw 16px;max-width:800px;margin:0 auto;}
.section-title{font-family:'Playfair Display',serif;font-size:26px;font-weight:400;color:var(--beige);margin-bottom:4px;}
.section-desc{font-size:12px;color:var(--muted);margin-bottom:20px;font-style:italic;}
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:40px;}
.product-card{background:var(--carbon2);border-radius:10px;overflow:hidden;border:1px solid rgba(245,236,216,.06);transition:border-color .2s,transform .15s;cursor:pointer;}
.product-card:hover{border-color:rgba(196,98,45,.4);transform:translateY(-2px);}
.product-img{width:100%;aspect-ratio:1;background:var(--carbon3);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.product-img img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;}
.product-img-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:100%;height:100%;}
.photo-icon{font-size:28px;opacity:.2;}
.photo-label{font-size:10px;color:rgba(245,236,216,.25);letter-spacing:.06em;text-align:center;padding:0 8px;}
.product-info{padding:10px 12px 12px;}
.product-name{font-family:'Playfair Display',serif;font-size:14px;font-weight:500;color:var(--beige);margin-bottom:3px;line-height:1.2;}
.product-desc{font-size:11px;color:var(--muted);line-height:1.4;margin-bottom:8px;font-style:italic;}
.product-tags{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px;}
.tag{font-size:9px;font-weight:500;padding:2px 6px;border-radius:3px;}
.tag-p{background:rgba(196,98,45,.15);color:#E89060;}
.tag-v{background:rgba(99,153,34,.15);color:#9ABE70;}
.product-footer{display:flex;align-items:center;justify-content:space-between;}
.product-price{font-size:15px;font-weight:400;color:var(--beige);}
.product-pzas{font-size:10px;color:var(--muted);}
.add-btn{width:28px;height:28px;border-radius:50%;background:var(--orange);border:none;color:var(--beige);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s;flex-shrink:0;font-family:'Jost',sans-serif;line-height:1;}
.add-btn.added{background:var(--green);}
.cart-panel{position:fixed;bottom:0;left:0;right:0;z-index:200;background:var(--carbon2);border-top:1px solid rgba(196,98,45,.3);padding:14px 5vw 20px;transform:translateY(100%);transition:transform .3s;max-height:70vh;overflow-y:auto;}
.cart-panel.open{transform:translateY(0);}
.cart-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.cart-title{font-family:'Playfair Display',serif;font-size:18px;color:var(--beige);}
.cart-close{background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer;}
.cart-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(245,236,216,.06);gap:10px;}
.cart-item-name{font-size:14px;color:var(--beige);flex:1;}
.cart-item-price{font-size:13px;color:var(--orange);white-space:nowrap;}
.cart-item-qty{display:flex;align-items:center;gap:8px;}
.qty-btn{background:none;border:1px solid rgba(245,236,216,.2);color:var(--beige);width:24px;height:24px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;}
.qty-num{font-size:14px;color:var(--beige);min-width:16px;text-align:center;}
.cart-empty{text-align:center;padding:20px;color:var(--muted);font-size:13px;}
.cart-total{display:flex;align-items:center;justify-content:space-between;padding:14px 0 0;}
.cart-total-label{font-size:13px;color:var(--muted);}
.cart-total-price{font-family:'Playfair Display',serif;font-size:22px;color:var(--beige);}
.whatsapp-btn{width:100%;background:#25D366;color:#fff;border:none;border-radius:8px;padding:14px;font-family:'Jost',sans-serif;font-size:14px;font-weight:500;cursor:pointer;margin-top:12px;display:flex;align-items:center;justify-content:center;gap:8px;}
.whatsapp-btn:disabled{background:var(--muted);cursor:default;}
.section-divider{border:none;border-top:1px solid rgba(245,236,216,.06);margin:0 5vw;}
footer{padding:40px 5vw 30px;text-align:center;border-top:1px solid rgba(245,236,216,.06);}
